{{!
    @template local_microlearning/engine_jobs

    Table of engine jobs (partial of the engine dashboard).

    Example context (json):
    {
        "hasjobs": true,
        "jobs": [{"withcourse": false, "courseid": 12, "kind": "Training", "learners": "-",
                  "state": "Running", "statecolor": "info", "started": "23/11/26, 14:00",
                  "duration": "-", "error": ""}]
    }
}}
{{#hasjobs}}
<table class="table table-sm align-middle">
    <thead><tr>
        <th>{{#str}} engine:jobkind, local_microlearning {{/str}}</th>
        {{#jobs.0.withcourse}}<th>{{#str}} course {{/str}}</th>{{/jobs.0.withcourse}}
        <th class="text-end">{{#str}} engine:learners, local_microlearning {{/str}}</th>
        <th>{{#str}} engine:jobstate, local_microlearning {{/str}}</th>
        <th>{{#str}} engine:started, local_microlearning {{/str}}</th>
        <th>{{#str}} engine:duration, local_microlearning {{/str}}</th>
    </tr></thead>
    <tbody>
    {{#jobs}}
        <tr>
            <td>{{kind}}</td>
            {{#withcourse}}<td>{{courseid}}</td>{{/withcourse}}
            <td class="text-end">{{learners}}</td>
            <td><span class="badge bg-{{statecolor}}">{{state}}</span>{{#error}}<div class="small text-danger">{{error}}</div>{{/error}}</td>
            <td>{{started}}</td>
            <td>{{duration}}</td>
        </tr>
    {{/jobs}}
    </tbody>
</table>
{{/hasjobs}}
{{^hasjobs}}<p class="ml-muted">{{#str}} engine:nojobs, local_microlearning {{/str}}</p>{{/hasjobs}}
