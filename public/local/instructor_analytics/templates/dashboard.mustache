{{!
    This file is part of Moodle - http://moodle.org/

    @template local_instructor_analytics/dashboard

    Shell for the instructor dashboard. All dynamic content is built by
    local_instructor_analytics/dashboard (AMD) from web service data.

    Context variables required for this template:
    * title - Page heading
    * canrun - Whether the user may run the pipeline

    Example context (json):
    {
        "title": "Class knowledge state",
        "canrun": true
    }
}}
<div class="local-ia" data-region="local-ia">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 local-ia-toolbar">
        <h3 class="mb-2">{{title}}</h3>
        {{#canrun}}
        <div class="local-ia-actions">
            <button type="button" class="btn btn-primary" data-action="run-pipeline">
                {{#str}} runpipeline, local_instructor_analytics {{/str}}
            </button>
            <span class="local-ia-status" data-region="status" role="status" aria-live="polite"></span>
        </div>
        {{/canrun}}
    </div>

    <div class="card">
        <div class="card-body">
            <h4 class="card-title">{{#str}} heatmaptitle, local_instructor_analytics {{/str}}</h4>
            <div data-region="summary" class="local-ia-summary mb-3"></div>
            <section class="local-ia-topic-chart mb-4" aria-labelledby="local-ia-topic-chart-title">
                <h5 id="local-ia-topic-chart-title">{{#str}} topicmasterytitle, local_instructor_analytics {{/str}}</h5>
                <div data-region="topic-chart" aria-live="polite"></div>
            </section>
            <div data-region="heatmap" aria-busy="true">
                <p class="text-muted mb-0">{{#str}} loading, local_instructor_analytics {{/str}}</p>
            </div>
            <p class="small text-muted mt-3 mb-0" data-region="footnote">{{#str}} legend, local_instructor_analytics {{/str}}</p>
        </div>
    </div>
</div>
